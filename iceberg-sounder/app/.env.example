# Copy to .env and fill in. The server reads this file on start.

# Required: Claude plans the dive and charts each layer.
ANTHROPIC_API_KEY=

# Required: Exa runs the web searches and fetches full pages. Get a key at dashboard.exa.ai.
EXA_API_KEY=

# Optional: turns on the Wikimedia Commons image gallery. Wikimedia asks API
# clients to identify themselves, so put an email address or a URL where you can be reached.
WIKIMEDIA_CONTACT=

# Optional
# PORT=3000
# HOST=127.0.0.1        # use 0.0.0.0 only behind auth: every dive spends your API credits
# ICEBERG_MODEL=claude-opus-5-5
# MAX_DIVES=2           # dives allowed to run at once
